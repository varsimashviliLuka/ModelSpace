# Copy to .env and fill in values

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# Upload settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=200
# Longest texture edge after upload (VRAM saver). 0 = disable server resize.
MAX_TEXTURE_EDGE=2048

# SSL (dev only — needed for Meta Quest 3 VR)
SSL_CERT=certs/cert.pem
SSL_KEY=certs/key.pem

# ── VR / WebXR controller settings ────────────────────────────
# Button binding format: "controllerIndex:buttonIndex"
# Meta Quest 3 face buttons: X=4, Y=5 (left ctrl=0), A=4, B=5 (right ctrl=1)
VR_MOVE_SPEED=0.03        # metres per frame at full stick deflection
VR_SNAP_ANGLE=45          # degrees per snap turn
VR_HEIGHT_STEP=0.1        # metres per A/B press
VR_HEIGHT_MIN=-2.0        # minimum height offset from spawn point
VR_HEIGHT_MAX=2.0         # maximum height offset
VR_BTN_MENU_TOGGLE=0:4    # left X  → toggle VR panel
VR_BTN_ANIM_TOGGLE=0:5    # left Y  → play/pause animation
VR_BTN_HEIGHT_DOWN=1:4    # right A → lower height
VR_BTN_HEIGHT_UP=1:5      # right B → raise height
VR_ZOOM_SPEED=0.05       # metres per frame at full right-stick Y deflection
VR_ZOOM_MIN=0.3          # minimum radial distance from model (metres)
VR_ZOOM_MAX=15.0         # maximum radial distance from model (metres)
VR_SMOOTH_TURN=0         # 0 = snap turn (default), 1 = smooth continuous turn
VR_TURN_SPEED=1.5        # smooth turn speed in radians/second (only if SMOOTH_TURN=1)
VR_DEADZONE=0.12         # thumbstick deadzone (0-1)
